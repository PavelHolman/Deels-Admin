"""
A filter to be used against `Campaign` object types. All fields are combined with a logical ‘and.’
"""
input CampaignFilter {
  """
  Filter by the object’s `id` field.
  """
  id: UUIDFilter

  """
  Filter by the object’s `bundle` relation.
  """
  bundle: BundleFilter

  """
  A related `bundle` exists.
  """
  bundleExists: Boolean

  """
  Filter by the object’s `discount` relation.
  """
  discount: DiscountFilter

  """
  A related `discount` exists.
  """
  discountExists: Boolean

  """
  Filter by the object’s `loyalty` relation.
  """
  loyalty: LoyaltyFilter

  """
  A related `loyalty` exists.
  """
  loyaltyExists: Boolean

  """
  Filter by the object’s `couponSessions` relation.
  """
  couponSessions: CampaignToManyCouponSessionFilter

  """
  Some related `couponSessions` exist.
  """
  couponSessionsExist: Boolean

  """
  Filter by the object’s `tagCampaigns` relation.
  """
  tagCampaigns: CampaignToManyTagCampaignFilter

  """
  Some related `tagCampaigns` exist.
  """
  tagCampaignsExist: Boolean

  """
  Filter by the object’s `secretGroupCampaigns` relation.
  """
  secretGroupCampaigns: CampaignToManySecretGroupCampaignFilter

  """
  Some related `secretGroupCampaigns` exist.
  """
  secretGroupCampaignsExist: Boolean

  """
  Filter by the object’s `secretAccesses` relation.
  """
  secretAccesses: CampaignToManySecretAccessFilter

  """
  Some related `secretAccesses` exist.
  """
  secretAccessesExist: Boolean

  """
  Checks for all expressions in this list.
  """
  and: [CampaignFilter!]

  """
  Checks for any expressions in this list.
  """
  or: [CampaignFilter!]

  """
  Negates the expression.
  """
  not: CampaignFilter
