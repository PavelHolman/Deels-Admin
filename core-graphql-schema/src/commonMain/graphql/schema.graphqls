"""
Represents voucher claimed via voucher code that allows the owner to get discount on orders.
"""
type Voucher {
  """
  Calculates the expiration date of a voucher based on its associated voucher code's expiration settings.
  It returns the earliest expiration date between the voucher code's fixed expiration date and a dynamic expiration date
  calculated by adding a specified number of days to the voucher's creation date extended to the end of that day.
  Careful!!! Expiration is calculated dynamically based on the device timezone from header. If no timezone is set, Europe/Prague is used.
  """
  expiration: Datetime

  """
  Determines the global state of a voucher. States:
  USED: The voucher has already been applied to at least one order.
  EXPIRED: The voucher's expiration date (fixed or relative) is in the past.
  AVAILABLE: The voucher is unused and not expired.
  Careful!!! State uses expiration for calculation, that uses users timezone from header. If no timezone is set, Europe/Prague is used.
  """
  state: VoucherState!

  """
  Determines the state of a voucher for a specific order. States:
  USED: The voucher has already been applied to at least one order.
  EXPIRED: The voucher is expired based on its fixed or relative expiration rules.
  TOO_CHEAP: The order total is below the voucher's minimum order price requirement.
  AVAILABLE: The voucher is valid, not expired, not used, and applicable to the given order.
  Careful!!! State uses expiration for calculation, that uses users timezone from header. If no timezone is set, Europe/Prague is used.
  """
  stateForOrder(orderId: UUID!): VoucherStateForOrder!

  """
  Returns all orders where the voucher has been applied. Eg. orders where the payment is being processed or is in a final successful state.
  Total number of these orders shouldn't exceed the usage_limit.
  """
  ordersWhereApplied("Only read the first `n` values of the set." first: Int, "Skip the first `n` values from our `after` cursor, an alternative to cursor\nbased pagination. May not be used with `last`." offset: Int, "Read all values in the set after (below) this cursor." after: Cursor, "A filter to be used in determining which values should be returned by the collection." filter: OrderFilter): OrderConnection!

  id: UUID!

  ownerId: String!

  voucherCodeId: UUID!

  created: Datetime!

  statePeriod: DatetimeRange!

  """
  Reads a single `VoucherCode` that is related to this `Voucher`.
  """
  voucherCode: VoucherCode!

  """
  Reads and enables pagination through a set of `VoucherUsage`.
  """
  voucherUsages("Only read the first `n` values of the set." first: Int, "Only read the last `n` values of the set." last: Int, "Skip the first `n` values from our `after` cursor, an alternative to cursor\nbased pagination. May not be used with `last`." offset: Int, "Read all values in the set before (above) this cursor." before: Cursor, "Read all values in the set after (below) this cursor." after: Cursor, "A condition to be used in determining which values should be returned by the collection." condition: VoucherUsageCondition, "A filter to be used in determining which values should be returned by the collection." filter: VoucherUsageFilter, "The method to use when ordering `VoucherUsage`." orderBy: [VoucherUsageOrderBy!] = [PRIMARY_KEY_ASC]): VoucherUsageConnection!
}

