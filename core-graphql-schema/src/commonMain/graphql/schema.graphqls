"""
A condition to be used against `Order` object types. All fields are tested for equality and combined with a logical ‘and.’
"""
input OrderCondition {
  """
  Checks for equality with the object’s `id` field.
  """
  id: UUID

  """
  Checks for equality with the object’s `variableSymbol` field.
  """
  variableSymbol: BigInt

  """
  Checks for equality with the object’s `customerId` field.
  """
  customerId: String

  """
  Checks for equality with the object’s `storeId` field.
  """
  storeId: UUID

  """
  Checks for equality with the object’s `qrCode` field.
  """
  qrCode: String

  """
  Checks for equality with the object’s `scannerId` field.
  """
  scannerId: String

  """
  Checks for equality with the object’s `created` field.
  """
  created: Datetime

  """
  Checks for equality with the object’s `state` field.
  """
  state: OrderState

  """
  Checks for equality with the object’s `countsTowardsUsage` field.
  """
  countsTowardsUsage: Boolean

  """
  Checks for equality with the object’s `deelsShare` field.
  """
  deelsShare: BigFloat

  """
  Checks for equality with the object’s `deelsShareWeChargeToStore` field.
  """
  deelsShareWeChargeToStore: BigFloat

  """
  Checks for equality with the object’s `paidAmount` field.
  """
  paidAmount: BigFloat

  """
  Checks for equality with the object’s `price` field.
  """
  price: BigFloat

  """
  Checks for equality with the object’s `storeRevenue` field.
  """
  storeRevenue: BigFloat

  """
  Checks for equality with the object’s `storeShare` field.
  """
  storeShare: BigFloat

  """
  Checks for equality with the object’s `totalSum` field.
  """
  totalSum: BigFloat

  """
  Checks for equality with the object’s `transactionFeeSum` field.
  """
  transactionFeeSum: BigFloat

  """
  Checks for equality with the object’s `voucherDiscountAvailable` field.
  """
  voucherDiscountAvailable: BigFloat

  """
  Checks for equality with the object’s `voucherDiscountUsed` field.
  """
  voucherDiscountUsed: BigFloat

  """
  Checks for equality with the object’s `expiration` field.
  """
  expiration: Datetime
}

