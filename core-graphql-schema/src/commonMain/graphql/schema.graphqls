type DiscountItem {
  """
  Calculates the Deel's cut for a discount item as ROUND(revenue * deels cut) + transaction fee.
  """
  deelsCut: BigFloat!

  """
  Price for customer.
  Calculates the effective price of a discount item by applying its discount percentage plus deels contribution percentage from the discount snapshot. 
  Uses the product price from product snapshot.
  Caps total discount at 100%. 
  Rounds the resulting price to the nearest integer.
  """
  productPrice: BigFloat!

  """
  Calculates the store's revenue for a discount item by applying the discount percentage from the discount snapshot to the product price from the product snapshot.
  Rounds the resulting revenue to the nearest integer.
  Returned number will differ from productPrice if deels contribution percentage is used.
  For example if product price is 100, discount percentage is 40% and deels contribution percentage is 20%, the store revenue will be 60 (100 * (1 - 40%)) while the product price for customer will be 40 (100 * (1 - (40% + 20%))).
  Use this to calculate store revenue and revenue shares.
  """
  productPriceWithoutContribution: BigFloat!

  """
  Returns the effective availability hours for a discount item by intersecting the store's opening hours (from store_history) with the store discount's active hours (from store_discount_history).
  """
  snapshotAvailabilityHours: [ActiveHour!]!

  id: UUID!

  orderId: UUID!

  discountId: UUID!

  discountStateStart: Datetime!

  productId: UUID!

  productStateStart: Datetime!

  transactionFee: BigFloat!

  deelsCutPercentage: BigFloat!

  expiration: Datetime!

  created: Datetime!

  statePeriod: DatetimeRange!

  storeId: UUID!

  storeDiscountStateStart: Datetime!

  """
  Reads a single `Order` that is related to this `DiscountItem`.
  """
  order: Order!

  """
  Reads a single `DiscountHistory` that is related to this `DiscountItem`.
  """
  discountSnapshot: DiscountHistory!

  """
  Reads a single `ProductHistory` that is related to this `DiscountItem`.
  """
  productSnapshot: ProductHistory!

  """
  Reads a single `StoreDiscountHistory` that is related to this `DiscountItem`.
  """
  storeDiscountSnapshot: StoreDiscountHistory!
}

type Order {
  """
  Computes the *theoretical* Deel’s share for an order, based on discounts and bundle items including transaction fees.
  ⚠️ Important:  
  This value is purely the calculated share amount.  
  It does *not* check the order state and does not guarantee that this amount will be invoiced to the store.  
  To get the final, invoiceable Deel’s share, use deelsShareWeChargeToStore.
  """
  deelsShare: BigFloat!

  """
  Returns the actual Deel’s share that will be invoiced to the store for this order including transaction fees.
  If the order is in a state where Deel’s share applies, returns the computed deelsShare.
  Otherwise (e.g. NEW, REJECTED_MINOR, ...), returns 0.  
  """
  deelsShareWeChargeToStore: BigFloat!

  """
  Returns the total amount paid by user for this order.
  """
  paidAmount: BigFloat!

  """
  Calculates the price of an order by summing up the prices of all associated bundle items and discount items. 
  Does not include service fees and voucher discounts!!!
  """
  price: BigFloat!

  """
  Calculates the store's total revenue for a given order.
  Behavior by order state:
  • For active/completed states (`PICKED_UP`, `PAYMENT_DELIVERED`, `PAYMENT_PROCESSED`, `STORE_SHARE_SENT`):
    → Returns full store-level revenues (including transaction fees taxed at 21%).
  • For expired states (`EXPIRED`, `EXPIRED__PAYMENT_DELIVERED`, `EXPIRED__PAYMENT_PROCESSED`):
    → Returns only Deel's cut, plus transaction fees taxed at 21%.
  • For other states:
    → Returns an empty array.
  """
  storeRevenue: BigFloat!

  """
  Returns the store’s share that will be paid out to the store for a given order.
  This is calculated as the store's total revenue minus the Deel's share we charge to the store.
  """
  storeShare: BigFloat!

  """
  Calculates the total sum of an order by adding the price of the order, transaction fee sum and subtracting any voucher discounts applied to the order.
  The calculated value is capped at a minimum of 0.
  """
  totalSum: BigFloat!

  """
  Sum of transaction fees for all items in the order.
  """
  transactionFeeSum: BigFloat!

  """
  Calculates the total voucher discount monetary amount available for the given order.
  Sums the amounts of all voucher usages for the order.
  """
  voucherDiscountAvailable: BigFloat!

  """
  Calculates the total voucher discount actually used for the order based on its state:
  1. If SOLD: Capped at the subtotal (price + transaction fees).
  2. If EXPIRED: Capped at the Deels share (orders_deels_share).
  3. Otherwise: Returns 0.
  This represents the actual amount covered by vouchers.
  """
  voucherDiscountUsed: BigFloat!

  expiration: Datetime

  """
  Aggregates Deel's revenue values by VAT rate for a given order.
  Behavior by order state:
  • For active/completed states (`PICKED_UP`, `PAYMENT_DELIVERED`, `PAYMENT_PROCESSED`, `STORE_SHARE_SENT`, `FREE__PICKED_UP`):
    → Returns full store-level revenues (including transaction fees taxed at 21%).
  • For expired states (`EXPIRED`, `EXPIRED__PAYMENT_DELIVERED`, `EXPIRED__PAYMENT_PROCESSED`, `FREE__EXPIRED`):
    → Returns only Deel's cut, plus transaction fees taxed at 21%.
  • For other states:
    → Returns an empty array.
  Each array element contains the total revenue sum for one VAT rate.
  """
  storeRevenueByVat: [PriceWithVat!]!

  id: UUID!

  variableSymbol: BigInt!

  customerId: String!

  storeId: UUID!

  qrCode: String!

  scannerId: String

  currency: Currency!

  created: Datetime!

  statePeriod: DatetimeRange!

  storeStateStart: Datetime!

  storeInternalStateStart: Datetime!

  state: OrderState!

  """
  Whether this order, in its current state, should be counted as a usage of its coupon towards the coupon's usage limits.
  For example, if we have a campaign which is only applicable once, we do not want the user to loose access to it if the order tied to it is rejected by the store or if they fail to pick the order up. In that case, the order will not be counted towards the campaign's limits.
  """
  countsTowardsUsage: Boolean!

  receiptUrl: String

  storeReceiptUrl: String

