}

"""
A simplified payment state used across all payment providers. This should be the source of truth for determining the
current state of a payment.

When the payment state is 'PAID', the payment can either be in an authorization hold or fully deducted. Which of the two
it is can be determined by the amount_deducted column.
- 'PAID' state and amount_deducted = null means the payment is in an authorization hold.
- 'PAID' state and non null amount_deducted means the payment has been deducted.

If we release an authorization hold without deducting, the state should be changed to 'CANCELLED' and amount_deducted
would be null.
"""
enum PaymentState {
  PENDING

  CANCELLED

  PAID
}

enum CsobPaymentState {
  CREATED

  IN_PROGRESS

  CANCELLED

  AUTHORIZED

  REVOKED

  REJECTED

  WAITING_FOR_SETTLEMENT

  SETTLED

  REFUND_PROCESSING

  REFUNDED
}

enum ComgatePaymentState {
  PENDING

  AUTHORIZED

  PAID

  CANCELLED
}

enum PaymentGateway {
  CSOB

  COMGATE
}

enum CampaignSubtype {
  DEFAULT

  LUNCH_MENU

  ECO
}

enum LoyaltySessionState {
  NEW

  ACTIVE

  POINTS_COLLECTED

  REWARD_SELECTED

  REWARD_PICKED_UP

  EXPIRATION_ACKNOWLEDGED

  EXPIRED
}

enum BusinessRole {
  ADMIN

  OWNER

  CHIEF
}

enum SecretCodeTemplateType {
  REFERRAL

  APOLOGY
}

enum VoucherState {
  AVAILABLE

  EXPIRED

  USED
}

enum Currency {
  CZK

  EUR
}

